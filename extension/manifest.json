{
  "manifest_version": 3,
  "name": "LifeOS Tracker",
  "version": "1.0.0",
  "description": "Track your browsing, YouTube, and screen time. Stay accountable.",
  "permissions": [
    "tabs",
    "activeTab",
    "idle",
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}