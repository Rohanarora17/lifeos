{
  "manifest_version": 3,
  "name": "LifeOS Tracker",
  "version": "1.2.0",
  "description": "Track your browsing, YouTube, and screen time. Stay accountable.",
  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "idle",
    "alarms",
    "notifications",
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "windows",
    "offscreen",
    "nativeMessaging"
  ],
  "commands": {
    "push-to-talk": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Push to talk — hold to record, release to send"
    }
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "guardian.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
