# Gemini uses Vertex AI with Application Default Credentials (ADC).
# Local setup: gcloud auth application-default login
# Production: attach a runtime service account with roles/aiplatform.user.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# LifeOS server origin. Keep this private deployment URL accurate for LiveKit.
LIFEOS_APP_URL=http://127.0.0.1:3000

# Guardian capture reliability. The server blocks session starts unless the
# expected MacBook client has a fresh, permission-authorized heartbeat.
LIFEOS_REQUIRE_VISION_CLIENT=true
# LIFEOS_MACBOOK_DEVICE_ID=Rohans-MacBook-Pro
# New sessions default to shadow mode for two controlled comparisons. Change to
# authoritative only after the Activity diagnostics show no overlaps or gaps.
LIFEOS_GUARDIAN_EVIDENCE_MODE=shadow
# LIFEOS_EXTENSION_DISTRIBUTION=unpacked_manual_reload

# Put these in ~/.config/lifeos/client.env on the MacBook, not on the server:
# LIFEOS_DEVICE_ID=Rohans-MacBook-Pro
# LIFEOS_EXTENSION_ID=copy-from-chrome-extensions

# Voice defaults to local push-to-talk. Set google-live only after configuring
# LiveKit and verifying the selected Vertex-native-audio model in your project.
VOICE_MODE=local
CLOUD_REASONING_MODE=cloud-reasoning
# LIVEKIT_WS_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=lifeos-guardian-agent
# LIVEKIT_GUARDIAN_MODEL=
# LIVEKIT_GUARDIAN_VOICE=Aoede
# LIFEOS_MAX_CONCURRENT_LIVE_SESSIONS=1
# LIFEOS_MAX_DAILY_LIVE_MINUTES=120

# Optional Google Calendar OAuth. Keep client secrets server-side.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary

# Optional local speech-to-text endpoint.
# WHISPER_CPP_URL=http://127.0.0.1:8080

# Do not configure GEMINI_API_KEY, GOOGLE_API_KEY, or a service-account JSON
# path for LifeOS Gemini. The runtime uses Vertex AI ADC instead.
